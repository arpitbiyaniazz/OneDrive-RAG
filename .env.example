# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | production (production enforces the checks below)
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text | json
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=              # encrypts stored OAuth tokens; changing it disconnects every drive
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (docker compose overrides this for the backend container)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/onedrive_rag

# ---------------------------------------------------------------------------
# Chat model and embeddings
# ---------------------------------------------------------------------------
LLM_PROVIDER=mistral               # mistral | openai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=mistral         # mistral | openai
EMBEDDING_MODEL=mistral-embed      # OpenAI: text-embedding-3-small (dimension 1536)
EMBEDDING_DIMENSION=1024           # must match the model; see README "Changing the embedding model"

# ---------------------------------------------------------------------------
# Microsoft OneDrive (Entra ID app registration, see docs/AZURE_SETUP.md)
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback
ONEDRIVE_ROOT_FOLDER=OneDrive-RAG  # only files inside this top-level folder are visible

# ---------------------------------------------------------------------------
# Google Drive (Google Cloud OAuth client, see docs/GOOGLE_SETUP.md)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_DRIVE_ROOT_FOLDER=OneDrive-RAG

# Sandbox drives with generated sample files, for local development without OAuth apps.
# Never enable in production (the server refuses to start).
DEV_MOCK_ONEDRIVE=false
DEV_MOCK_GDRIVE=false

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=       # e.g. http://localhost:4317 with observability/docker-compose.offline.yml
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
