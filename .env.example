# ==========================================
# Microsoft Entra ID (Azure) OAuth & Graph API
# ==========================================
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback
# Set DEV_MOCK_ONEDRIVE=true to test full folder navigation & ingestion without Azure setup
DEV_MOCK_ONEDRIVE=true

# ==========================================
# Google Drive OAuth 2.0 & API v3
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Set DEV_MOCK_GDRIVE=true to test Google Docs, Sheets, Slides & binary ingestion without GCP setup
DEV_MOCK_GDRIVE=true
GOOGLE_WEBHOOK_SECRET=gdrive-rag-webhook-secret-token

# ==========================================
# Database & Vector Store
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/onedrive_rag
# Used for sync operations/migrations if needed
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/onedrive_rag

# ==========================================
# AI Models (OpenAI / Azure OpenAI / Local)
# ==========================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ==========================================
# Observability: OpenTelemetry
# ==========================================
OTEL_SERVICE_NAME=onedrive-rag-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set to true to print formatted span traces to console in dev mode
OTEL_CONSOLE_EXPORTER=true

# ==========================================
# Observability: Langfuse
# ==========================================
# Get free keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ==========================================
# Application & Security
# ==========================================
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long!
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-32-bytes!
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
