# ==============================================================================
# OFFLINE OBSERVABILITY CONFIGURATION (Local Stack)
# ==============================================================================
# Copy or merge these values into your root .env to enable 100% offline telemetry

# 1. OpenTelemetry -> Local Jaeger
OTEL_SERVICE_NAME=onedrive-rag-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_CONSOLE_EXPORTER=false

# 2. Langfuse -> Local Self-Hosted Langfuse Instance (or Mock Fallback)
# When running docker-compose.offline.yml, Langfuse runs at http://localhost:3000
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-test
LANGFUSE_SECRET_KEY=sk-lf-local-test

# 3. Development Sandbox Flags (Mock Cloud APIs offline)
DEV_MOCK_ONEDRIVE=true
DEV_MOCK_GDRIVE=true
