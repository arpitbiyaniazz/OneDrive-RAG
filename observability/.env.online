# ==============================================================================
# ONLINE OBSERVABILITY CONFIGURATION (Cloud SaaS Mode)
# ==============================================================================
# Copy or merge these values into your root .env to enable Cloud SaaS telemetry

# 1. OpenTelemetry -> Cloud APM or Cloud Gateway
OTEL_SERVICE_NAME=onedrive-rag-backend
# Option A: Send via local online collector gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Option B: Send directly to Cloud APM via HTTPS (e.g. Honeycomb or Grafana)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io:443
# OTEL_EXPORTER_OTLP_INSECURE=false
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your-honeycomb-api-key
OTEL_CONSOLE_EXPORTER=false

# 2. Langfuse Cloud (Get free API keys at https://cloud.langfuse.com)
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-actual-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-actual-secret-key

# 3. Optional Cloud APM Credentials (for otel-collector-online)
HONEYCOMB_API_KEY=
GRAFANA_TEMPO_ENDPOINT=
GRAFANA_TEMPO_AUTH=
NEW_RELIC_LICENSE_KEY=
