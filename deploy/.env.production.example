# Production settings for docker-compose.prod.yml (DEPLOY.md option A).
#   cp deploy/.env.production.example .env
# deploy/server-setup.sh copies this file and fills in DOMAIN, the URLs, ALLOWED_EMAILS and every generated secret.
# Never commit the filled-in .env, and keep a private copy of it off the server.
#
# Keep each comment on its own line: Docker Compose reads "KEY=   # text" as the value "# text".

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# The host name that points at this server, without https:// (for example a free DuckDNS name).
DOMAIN=yourname.duckdns.org
FRONTEND_URL=https://yourname.duckdns.org
CORS_ORIGINS=https://yourname.duckdns.org

# ---------------------------------------------------------------------------
# Who may sign in
# ---------------------------------------------------------------------------
# Comma-separated Google accounts and/or @domains, e.g. you@gmail.com,colleague@gmail.com,@yourcompany.com
# Leave it empty only while the Google OAuth app is in Testing: once it is published, any Google account
# could sign in and use your Mistral key.
ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# production refuses to start with development secrets, sandbox drives or mock models.
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
# Each at least 32 characters: openssl rand -hex 32
SECRET_KEY=
# Encrypts the stored Google tokens: changing it later disconnects every drive.
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (the postgres container; the backend's DATABASE_URL is built from these)
# ---------------------------------------------------------------------------
POSTGRES_USER=rag
# Letters and digits only, it goes into a URL: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=rag

# ---------------------------------------------------------------------------
# Chat model and embeddings (Mistral)
# ---------------------------------------------------------------------------
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
# The prompts and the answer guard were measured with this model. The code's default
# (mistral-small-latest) may not be available on your key.
MISTRAL_MODEL=ministral-8b-2512
EMBEDDING_PROVIDER=mistral
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSION=1024
# mistral: also read scanned PDFs (sends page images to Mistral OCR).
OCR_PROVIDER=none

# ---------------------------------------------------------------------------
# Google sign-in and Drive (docs/GOOGLE_SETUP.md and DEPLOY.md section 1)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourname.duckdns.org/auth/google/callback
# Only files inside this folder in My Drive are indexed.
GOOGLE_DRIVE_ROOT_FOLDER=OneDrive-RAG
DEV_MOCK_ONEDRIVE=false
DEV_MOCK_GDRIVE=false

# ---------------------------------------------------------------------------
# Observability: off unless you run a collector or have Langfuse keys
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
LANGFUSE_ENABLED=false
